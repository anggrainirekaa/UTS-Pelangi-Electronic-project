APP_NAME="Pelangi Elektronik"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database bawaan: SQLite (tidak perlu XAMPP/MySQL). Berkas database/database.sqlite sudah disertakan
# (berisi data demo) dan dibuat otomatis oleh `php artisan pelangi:setup` bila belum ada.
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true

# Opsional - MySQL/MariaDB: ganti DB_CONNECTION=mysql lalu isi baris berikut (database dibuat otomatis oleh pelangi:setup).
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pelangi_elektronik
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payment gateway (simulasi). Isi secret acak untuk mengaktifkan webhook pembayaran.
PAYMENT_DRIVER=simulated
PAYMENT_WEBHOOK_SECRET=

# --- Aturan bisnis Pelangi Elektronik (opsional; nilai bawaan ada di config/stockflow.php) ---
STOCKFLOW_MAX_STAFF_DISCOUNT=20
STOCKFLOW_RETURN_DAYS=7
STOCKFLOW_TRANSFER_APPROVAL_QTY=100
STOCKFLOW_RESTOCK_HISTORY_DAYS=30
STOCKFLOW_RESTOCK_COVERAGE_DAYS=14
